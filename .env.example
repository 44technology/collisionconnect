# Firebase – Proje Ayarları > Genel > Uygulamanız > Config değerlerini buraya kopyalayın
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opsiyonel: WhatsApp ile gönderilen linklerde kullanılacak numara (ülke kodu + numara, boşluk yok)
# VITE_WHATSAPP_NUMBER=19542499084

# Opsiyonel: Quote link base URL (Netlify deploy URL’iniz)
# Örnek: canlı Fixly URL’iniz
# VITE_APP_URL=https://fixly.yourdomain.com

# Opsiyonel: Google body shop araması (Maps JavaScript API + Places API açık olmalı)
# VITE_GOOGLE_MAPS_API_KEY=your_google_api_key

# Opsiyonel: VPIC (NHTSA) API için CORS proxy.
# Firebase function url örneği: https://<region>-<project>.cloudfunctions.net/vpicProxy
# Bu set edilirse vehicleApi istekleri direkt VPIC yerine bu proxy üzerinden yapılır.
# VITE_VPIC_PROXY_URL=
